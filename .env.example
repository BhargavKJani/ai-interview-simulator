# Copy to .env.local (or add these in Vercel → Project → Settings → Environment Variables).
# With nothing set, the app runs in free demo mode with no sign-in and no payments.
# Claude is used only when ALL of the keys below are set, and only for signed-in users with free uses or a paid plan.

# Claude API key (console.anthropic.com → API keys). Set a monthly spend limit there too.
ANTHROPIC_API_KEY=

# Supabase (supabase.com → your project → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: never share it or put it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (dashboard.razorpay.com → Account & Settings → API Keys). Use rzp_test_… keys until KYC is approved.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Webhooks → add https://YOUR-SITE/api/billing/webhook with events payment.captured and order.paid.
RAZORPAY_WEBHOOK_SECRET=
